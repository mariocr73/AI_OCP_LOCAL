#!/bin/bash
# ===========================================================
# virt-install command for OCP master node: {{ item.name }}
# Generated by Ansible - do not edit manually
#
# Variables:
#   item.name    = {{ item.name }}
#   item.cpu     = {{ item.cpu }}
#   item.ram_gb  = {{ item.ram_gb }}
#   item.disk_gb = {{ item.disk_gb }}
#   item.mac     = {{ item.mac }}
# ===========================================================

set -euo pipefail

virt-install \
  --name "{{ item.name }}" \
  --cpu host-passthrough \
  --vcpus "{{ item.cpu }}" \
  --memory "{{ item.ram_gb * 1024 }}" \
  --disk "path={{ iso_dir }}/{{ item.name }}.qcow2,size={{ item.disk_gb }},format=qcow2,bus=virtio,cache=none" \
  --cdrom "{{ iso_dir }}/discovery-image.iso" \
  --network "network={{ libvirt_network.name }},mac={{ item.mac }},model=virtio" \
  --os-variant "rhel9-unknown" \
  --boot "hd,cdrom" \
  --graphics vnc,listen=0.0.0.0 \
  --noautoconsole \
  --events on_reboot=restart \
  --import
